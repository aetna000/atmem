{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atmem-feedback-source-revision-v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "atmem-feedback-source-revision-v1"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "format",
    "source_id",
    "revision",
    "content_sha256"
  ],
  "additionalProperties": false
}
