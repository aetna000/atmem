{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atmem-rag-source-v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "atmem-rag-source-v1"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "format": {
          "const": "atmem-feedback-scope-v1"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        }
      },
      "required": [
        "format",
        "tenant_id",
        "subject_id",
        "agent_id",
        "workspace_id"
      ],
      "additionalProperties": false
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "revision": {
      "type": "string",
      "maxLength": 65536
    },
    "egress": {
      "enum": [
        "none",
        "remote"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    }
  },
  "required": [
    "format",
    "source_id",
    "scope",
    "provider_id",
    "collection_id",
    "revision",
    "egress"
  ],
  "additionalProperties": false
}
