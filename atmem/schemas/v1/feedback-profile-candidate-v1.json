{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atmem-feedback-profile-candidate-v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "atmem-feedback-profile-candidate-v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "format": {
          "const": "atmem-feedback-scope-v1"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        }
      },
      "required": [
        "format",
        "tenant_id",
        "subject_id",
        "agent_id",
        "workspace_id"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "const": "atmem-feedback-source-revision-v1"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740992
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "format",
          "source_id",
          "revision",
          "content_sha256"
        ],
        "additionalProperties": false
      }
    },
    "candidate_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "context_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "balanced_pools": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    }
  },
  "required": [
    "format",
    "profile_id",
    "scope",
    "sources"
  ],
  "additionalProperties": false
}
