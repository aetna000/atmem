{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmem.dev/schemas/v1/evidence-neighborhood.json",
  "type": "object",
  "required": ["format", "neighborhood_id", "need_id", "seed_record_ids", "paths", "selected_record_ids", "visited_count", "max_depth", "truncated"],
  "properties": {
    "format": {"const": "atmem-evidence-neighborhood-v1"},
    "neighborhood_id": {"type": "string", "minLength": 1, "maxLength": 128}, "need_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "seed_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "selected_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "visited_count": {"type": "integer", "minimum": 0}, "max_depth": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "paths": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["format", "seed_record_id", "record_id", "edge_types", "depth", "reason_code"], "properties": {"format": {"const": "atmem-evidence-path-v1"}, "seed_record_id": {"type": "string", "minLength": 1, "maxLength": 128}, "record_id": {"type": "string", "minLength": 1, "maxLength": 128}, "edge_types": {"type": "array", "items": {"type": "string", "minLength": 1}}, "depth": {"type": "integer", "minimum": 0}, "reason_code": {"type": "string", "minLength": 1, "maxLength": 128}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
