{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmem.dev/schemas/v1/recall-request.json",
  "title": "AtMem governed recall request v1",
  "type": "object",
  "required": ["format", "request_id", "scope", "query"],
  "properties": {
    "format": {"const": "atmem-recall-request-v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {"$ref": "scope.json"},
    "query": {"type": "string", "minLength": 1},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "candidate_limit": {"type": "integer", "minimum": 1, "maximum": 2000},
    "signals": {"type": "array", "minItems": 1, "items": {"enum": ["lexical", "semantic", "graph", "trust", "recency"]}},
    "context_budget_chars": {"type": "integer", "minimum": 1},
    "reranker_provider": {"type": "string"},
    "reranker_model": {"type": "string"},
    "egress_class": {"enum": ["local", "remote", "none"]},
    "min_score": {"type": "number"}
  },
  "additionalProperties": false
}
