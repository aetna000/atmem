{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmem.dev/schemas/v1/information-need.json",
  "type": "object",
  "required": ["format", "need_id", "type", "required_slots"],
  "properties": {
    "format": {"const": "atmem-information-need-v1"},
    "need_id": {"type": "string", "minLength": 1},
    "type": {"enum": ["exact_fact", "current_state", "state_change", "ordered_task", "exception_risk", "rule_application", "assumption_check", "relational_synthesis"]},
    "entities": {"type": "array", "items": {"type": "string"}},
    "relation_or_action": {"type": ["string", "null"]},
    "temporal_target": {"type": ["string", "null"]},
    "polarity": {"enum": ["positive", "negative", "unknown"]},
    "expected_form": {"type": ["string", "null"]},
    "required_slots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "parent_need_id": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
