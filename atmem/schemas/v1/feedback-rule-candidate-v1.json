{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atmem-feedback-rule-candidate-v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "atmem-feedback-rule-candidate-v1"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "format": {
          "const": "atmem-feedback-scope-v1"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        }
      },
      "required": [
        "format",
        "tenant_id",
        "subject_id",
        "agent_id",
        "workspace_id"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": "string",
      "maxLength": 65536
    },
    "schema_version": {
      "type": "string",
      "maxLength": 65536
    },
    "sources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "const": "atmem-feedback-source-revision-v1"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740992
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "format",
          "source_id",
          "revision",
          "content_sha256"
        ],
        "additionalProperties": false
      }
    },
    "predicates": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "const": "atmem-feedback-rule-predicate-v1"
          },
          "operator": {
            "enum": [
              "present",
              "equals",
              "approval_required"
            ]
          },
          "path": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "value": {}
        },
        "required": [
          "format",
          "operator",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "rationale": {
      "type": "string",
      "maxLength": 65536
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    }
  },
  "required": [
    "format",
    "rule_id",
    "scope",
    "tool",
    "schema_version",
    "sources",
    "predicates",
    "rationale"
  ],
  "additionalProperties": false
}
