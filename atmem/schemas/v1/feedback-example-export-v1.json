{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atmem-feedback-example-export-v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "atmem-feedback-example-export-v1"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "format": {
          "const": "atmem-feedback-scope-v1"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        }
      },
      "required": [
        "format",
        "tenant_id",
        "subject_id",
        "agent_id",
        "workspace_id"
      ],
      "additionalProperties": false
    },
    "consent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "consent_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "purpose": {
      "type": "string",
      "maxLength": 65536
    },
    "recipient_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "outcome_ids": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 65536
      }
    },
    "preview_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "format",
    "export_id",
    "scope",
    "consent_id",
    "consent_revision",
    "purpose",
    "recipient_id",
    "outcome_ids",
    "preview_sha256"
  ],
  "additionalProperties": false
}
