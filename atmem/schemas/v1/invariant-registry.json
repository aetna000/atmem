{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmem.dev/schemas/v1/invariant-registry.json",
  "title": "AtMem Invariant Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "invariants"],
  "properties": {
    "format": {"const": "atmem-invariant-registry-v1"},
    "version": {"type": "string", "minLength": 1},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "guarantee", "principle", "owning_spec", "assertions", "configurations", "amendments"],
        "properties": {
          "invariant_id": {"type": "string", "pattern": "^INV-[0-9]{3}$"},
          "guarantee": {"type": "string", "minLength": 1},
          "principle": {"type": "string", "minLength": 1},
          "owning_spec": {"type": "string", "minLength": 1},
          "assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "configurations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "amendments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["reason", "principle", "compatibility_impact", "replacement_coverage"],
              "additionalProperties": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
