{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmem.dev/schemas/v1/task-state-proposal.json",
  "title": "AtMem governed task state proposal",
  "description": "An untrusted typed delta against an exact base revision. A proposal never commits; AtMem decides.",
  "type": "object",
  "required": [
    "format",
    "proposal_id",
    "task_id",
    "scope",
    "base_revision",
    "idempotency_key",
    "actor",
    "actor_role",
    "operations"
  ],
  "properties": {
    "format": {
      "const": "atmem-task-state-proposal-v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "scope": {
      "$ref": "scope.json"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actor_role": {
      "enum": [
        "atmem_authority",
        "policy_evaluator",
        "atbot_intelligence",
        "host_agent",
        "operator",
        "administrator",
        "verifier",
        "auditor",
        "delegated_provider"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "reference_id"
        ],
        "properties": {
          "format": {
            "const": "atmem-task-evidence-ref-v1"
          },
          "kind": {
            "enum": [
              "source",
              "record",
              "audit_event",
              "blackbox_event",
              "tool_call",
              "verifier_result",
              "operator_request",
              "policy_rule"
            ]
          },
          "reference_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "interpreter": {
      "type": [
        "string",
        "null"
      ]
    },
    "assurance": {
      "enum": [
        "asserted",
        "model_interpreted",
        "rule_extracted",
        "host_reported",
        "operator_confirmed",
        "independently_verified"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "action_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operation": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "format": {
          "const": "atmem-task-operation-v1"
        },
        "kind": {
          "enum": [
            "set_phase",
            "set_item_status",
            "add_item",
            "set_item_content",
            "set_item_blocker",
            "add_constraint",
            "satisfy_constraint",
            "mark_source_inspected",
            "lock_schema"
          ]
        },
        "item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "constraint_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "oneOf": [
            {
              "enum": [
                "pending",
                "ready",
                "running",
                "blocked",
                "completed",
                "skipped",
                "failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "content": {
          "type": [
            "object",
            "null"
          ]
        },
        "depends_on": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "kind_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "assurance": {
          "enum": [
            "asserted",
            "model_interpreted",
            "rule_extracted",
            "host_reported",
            "operator_confirmed",
            "independently_verified"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
