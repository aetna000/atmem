{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atmem-feedback-action-observation-v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "atmem-feedback-action-observation-v1"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "tool": {
      "type": "string",
      "maxLength": 65536
    },
    "schema_version": {
      "type": "string",
      "maxLength": 65536
    },
    "arguments": {
      "type": "object",
      "maxProperties": 128
    },
    "result": {},
    "checks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "const": "atmem-feedback-action-check-v1"
          },
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "mechanical",
              "judged"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "disputed"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "format",
          "check_id",
          "kind",
          "result",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "evidence_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 65536
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "format",
    "action_id",
    "invocation_id",
    "tool",
    "schema_version",
    "arguments",
    "result",
    "checks"
  ],
  "additionalProperties": false
}
