{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmem.dev/schemas/v1/task-state.json",
  "title": "AtMem governed task state",
  "description": "One immutable canonical snapshot of a governed task at a revision.",
  "type": "object",
  "required": [
    "format",
    "task_id",
    "scope",
    "revision",
    "lifecycle",
    "phase",
    "goal",
    "profile_id",
    "profile_version"
  ],
  "properties": {
    "format": {
      "const": "atmem-task-state-v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "scope": {
      "$ref": "scope.json"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycle": {
      "enum": [
        "open",
        "paused",
        "completed",
        "cancelled",
        "expired"
      ]
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "sources_to_inspect": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completed_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_locked": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "last_progress_at": {
      "type": "string"
    },
    "parent_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "policy_generation": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "item_id",
        "kind",
        "title",
        "status"
      ],
      "properties": {
        "format": {
          "const": "atmem-task-item-v1"
        },
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "running",
            "blocked",
            "completed",
            "skipped",
            "failed"
          ]
        },
        "content": {
          "type": "object"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocker_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "skip_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "assurance": {
          "enum": [
            "asserted",
            "model_interpreted",
            "rule_extracted",
            "host_reported",
            "operator_confirmed",
            "independently_verified"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "reference_id"
            ],
            "properties": {
              "format": {
                "const": "atmem-task-evidence-ref-v1"
              },
              "kind": {
                "enum": [
                  "source",
                  "record",
                  "audit_event",
                  "blackbox_event",
                  "tool_call",
                  "verifier_result",
                  "operator_request",
                  "policy_rule"
                ]
              },
              "reference_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": [
        "constraint_id",
        "text"
      ],
      "properties": {
        "format": {
          "const": "atmem-task-constraint-v1"
        },
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "satisfied": {
          "type": "boolean"
        },
        "required_for_completion": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
