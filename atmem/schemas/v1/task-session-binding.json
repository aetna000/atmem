{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmem.dev/schemas/v1/task-session-binding.json",
  "title": "AtMem governed task session binding",
  "description": "An operator-registered mapping from one host conversation to one governed task. The uniqueness key is scope plus host_type, session_key and session_epoch; task_id is the target and is deliberately outside it, which makes bindings many-to-one and makes retargeting impossible to express as an update.",
  "type": "object",
  "required": [
    "format",
    "binding_id",
    "scope",
    "identity",
    "task_id",
    "actor",
    "reason",
    "registered_at_utc"
  ],
  "properties": {
    "format": {
      "const": "atmem-task-session-binding-v1"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source": {
      "type": "string",
      "maxLength": 2000
    },
    "registered_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "revoked_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "revoked_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "revoked_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": [
        "subject_id",
        "agent_id",
        "workspace_id"
      ],
      "properties": {
        "format": {
          "const": "atmem-authority-scope-v1"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "description": "All three parts are required together. Hosts declare these fields as optional, so a partial identity is one AtMem cannot place; resolving on whatever survived would be guessing, and guessing is what the binding exists to prevent.",
      "required": [
        "host_type",
        "session_key",
        "session_epoch"
      ],
      "properties": {
        "format": {
          "const": "atmem-host-session-identity-v1"
        },
        "host_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "session_key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "session_epoch": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "reference_id"
      ],
      "properties": {
        "format": {
          "const": "atmem-task-evidence-ref-v1"
        },
        "kind": {
          "enum": [
            "source",
            "record",
            "audit_event",
            "blackbox_event",
            "tool_call",
            "verifier_result",
            "operator_request",
            "policy_rule"
          ]
        },
        "reference_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
