{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmem.dev/schemas/v1/retrieval-stage-event.json",
  "title": "AtMem retrieval stage event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "event_id", "request_id", "scope_digest", "profile_id", "stage", "status", "started_at", "duration_ms", "input_count", "output_count"],
  "properties": {
    "format": {"const": "atmem-retrieval-stage-event-v1"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "information_need": {"type": ["string", "null"]},
    "stage": {"enum": ["formation", "nomination", "expansion", "sufficiency", "packing", "delivery"]},
    "status": {"enum": ["completed", "partial", "withheld", "unavailable", "failed"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": ["number", "null"], "minimum": 0},
    "input_count": {"type": ["integer", "null"], "minimum": 0},
    "output_count": {"type": ["integer", "null"], "minimum": 0},
    "context_bytes": {"type": ["integer", "null"], "minimum": 0},
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "unavailable_reason": {"type": ["string", "null"]}
      }
    }
  }
}
