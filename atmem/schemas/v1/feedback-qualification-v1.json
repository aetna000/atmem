{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atmem-feedback-qualification-v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "atmem-feedback-qualification-v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "format": {
          "const": "atmem-feedback-scope-v1"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$",
          "maxLength": 256
        }
      },
      "required": [
        "format",
        "tenant_id",
        "subject_id",
        "agent_id",
        "workspace_id"
      ],
      "additionalProperties": false
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "versions": {
      "type": "object",
      "maxProperties": 128
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "inconclusive"
      ]
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "metrics": {
      "type": "object",
      "maxProperties": 128
    }
  },
  "required": [
    "format",
    "receipt_id",
    "scope",
    "artifact_sha256",
    "manifest_sha256",
    "versions",
    "decision",
    "issued_at",
    "expires_at",
    "metrics"
  ],
  "additionalProperties": false
}
