index 000000000..972b69173
--- /dev/null
+++ b/agent/tool_authorization.py
@@ -0,0 +1,51 @@
+"""Read-only policy admission at the terminal tool-dispatch boundary.
+
+Request hooks may rewrite arguments. Authorization hooks inspect a detached
+snapshot of the final call and can only veto it; a policy failure is a tool
+result, not an exception that aborts the conversation or falls through to I/O.
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+
+
+HOOK = "authorize_tool_call"
+UNAVAILABLE = "Tool not executed: final authorization is unavailable. Retry after the policy service recovers."
+INVALID = "Tool not executed: final authorization returned an invalid or modifying decision."
+
+
+def authorize_tool_call(tool_name: str, args: dict, **ids: Any) -> tuple[str | None, dict]:
+    """Return a veto or the exact detached arguments checked by final policies.
+
+    A final hook is an idempotent authorization check, never a transformation,
+    approval prompt or effect. It may be reached again as a wrapper resolves to
+    a concrete tool. Callers must invoke it after their last transformation and
+    immediately before dispatch; caller-owned mutable input is never executed
+    after a hooked check.
+    """
+    try:
+        from hermes_cli import plugins
+
+        if not plugins.has_hook(HOOK):
+            return None, args
+        encoded = json.dumps(args, sort_keys=True, separators=(",", ":"), allow_nan=False)
+        final_args = json.loads(encoded)
+        observed = json.loads(encoded)
+        results = plugins.invoke_hook(HOOK, tool_name=tool_name, args=observed, **ids)
+        if json.dumps(observed, sort_keys=True, separators=(",", ":"), allow_nan=False) != encoded:
+            return INVALID, final_args
+        for result in results:
+            if not isinstance(result, dict):
+                return INVALID, final_args
+            if set(result) - {"action", "message"} or result.get("action") not in {"allow", "block"}:
+                return INVALID, final_args
+            if result["action"] == "block":
+                message = result.get("message")
+                return (message if isinstance(message, str) and message.strip() else INVALID), final_args
+        return None, final_args
+    except (Exception, SystemExit):
+        # The exception may contain tool arguments or secrets. A bounded,
+        # content-free error is enough to tell the model nothing was executed.
+        return UNAVAILABLE, args
