+"""Actual plugin discovery and dispatch must agree on the final authorized call.
+
+Uses only a temporary local effect file, with no model or external service.
+"""
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.fixture
+def policy(tmp_path, monkeypatch):
+    from hermes_constants import get_hermes_home
+    from hermes_cli import plugins
+
+    home = get_hermes_home()
+    directory = home / "plugins" / "final-policy-probe"
+    directory.mkdir(parents=True)
+    (directory / "plugin.yaml").write_text('''name: final-policy-probe
+version: "1.0.0"
+description: "Isolated dispatch conformance fixture"
+provides_hooks: [pre_tool_call, authorize_tool_call]
+''')
+    (home / "config.yaml").write_text("plugins:\n  enabled: [final-policy-probe]\n")
+    (directory / "__init__.py").write_text('''
+import json
+from pathlib import Path
+import threading
+MODE = "allow"
+SEEN = []
+HOLD = threading.Event()
+EFFECT = Path(__file__).with_name("effect.json")
+CAPTURED = None
+
+def before(tool_name, args, **kwargs):
+    if MODE == "rewrite" and tool_name in {"policy_probe_write", "connectors__fixture__WRITE"}:
+        return {"action": "modify", "args": {"target": "production"}}
+
+def authorize(tool_name, args, **kwargs):
+    global CAPTURED
+    if tool_name not in {"policy_probe_write", "connectors__fixture__WRITE"}:
+        return None
+    SEEN.append(json.loads(json.dumps(args)))
+    CAPTURED = args
+    if MODE == "callback_error":
+        raise RuntimeError("PRIVATE-ARGUMENT-CONTENT")
+    if MODE == "timeout":
+        HOLD.wait(5)
+    if MODE == "invalid":
+        return {"action": "modify", "args": {"target": "staging"}}
+    if MODE == "mutation":
+        args["payload"]["approved"] = False
+    if args.get("target") == "production":
+        return {"action": "block", "message": "Production write requires separate approval."}
+    return {"action": "allow"}
+
+def execution(tool_name, args, next_call, **kwargs):
+    if MODE == "execution_rewrite" and tool_name in {"policy_probe_write", "connectors__fixture__WRITE"}:
+        return next_call({**args, "target": "production"})
+    return next_call(args)
+
+def write(args, **kwargs):
+    # A retained callback argument must not mutate the tool's checked snapshot.
+    if MODE == "late_mutation":
+        CAPTURED["payload"]["approved"] = False
+    EFFECT.write_text(json.dumps(args))
+    return json.dumps({"ok": True})
+
+def register(ctx):
+    ctx.register_hook("pre_tool_call", before)
+    ctx.register_hook("authorize_tool_call", authorize)
+    ctx.register_middleware("tool_execution", execution)
+    ctx.register_tool("policy_probe_write", "policy-probe",
+        {"name": "policy_probe_write", "parameters": {"type": "object"}}, write)
+''')
+    # Load the fixture through the actual profile-scoped directory loader.
+    manager = plugins.PluginManager()
+    monkeypatch.setattr(plugins, "get_plugin_manager", lambda: manager)
+    manager.discover_and_load(force=True)
+    loaded = manager._plugins["final-policy-probe"]
+    assert loaded.enabled and loaded.error is None
+    module = loaded.module
+    from tools.connectors.gateway import bridge, config
+    from tools.registry import invalidate_check_fn_cache
+    monkeypatch.setattr(config, "connectors_available", lambda: True)
+    monkeypatch.setattr(bridge, "connectors_available", lambda: True)
+    invalidate_check_fn_cache()
+
+    class Client:
+        def execute(self, plans):
+            return [{"data": json.loads(module.write(p.arguments)), "error": None} for p in plans]
+
+    monkeypatch.setattr(bridge, "_default_client_factory", Client)
+    try:
+        yield module
+    finally:
+        module.HOLD.set()
+        manager.unload("final-policy-probe")
+
+
+def _invoke(path, policy):
+    args = {"target": "staging", "payload": {"approved": True}}
+    if path == "direct":
+        from model_tools import handle_function_call
+        return handle_function_call("policy_probe_write", args, task_id="policy-task", tool_call_id="call-1")
+    if path in {"connector", "connector_batch"}:
+        from model_tools import handle_function_call
+        name = "connectors__fixture__WRITE"
+        if path == "connector_batch":
+            args = {"calls": [{"name": name, "arguments": args}]}
+            name = "tool_call"
+        result = json.loads(handle_function_call(
+            name, args, task_id="policy-task", tool_call_id="call-1", enabled_toolsets=["connections"],
+        ))
+        if path == "connector_batch":
+            result = result["results"][0]
+        return json.dumps(result.get("response", result))
+    from agent.tool_executor import _run_agent_tool_execution_middleware
+    agent = SimpleNamespace(
+        session_id="policy-session", _current_turn_id="turn-1", _current_api_request_id="request-1",
+        _tool_guardrails=SimpleNamespace(before_call=lambda *a: SimpleNamespace(allows_execution=True)),
+        verbose_logging=False, quiet_mode=True, tool_progress_callback=None, tool_start_callback=None,
+        _touch_activity=lambda *a: None, _checkpoint_mgr=SimpleNamespace(enabled=False),
+    )
+    managed = _run_agent_tool_execution_middleware(
+        agent, function_name="policy_probe_write", function_args=args,
+        effective_task_id="policy-task", tool_call_id="call-1", execute=policy.write,
+    )
+    return managed.result
+
+
+@pytest.mark.parametrize("path", ["direct", "agent", "connector", "connector_batch"])
+@pytest.mark.parametrize("mode", [
+    "allow", "rewrite", "execution_rewrite", "callback_error", "invalid", "mutation", "late_mutation", "timeout",
+])
+def test_final_policy_controls_real_effect_after_rewrites(policy, monkeypatch, caplog, path, mode):
+    policy.MODE = mode
+    monkeypatch.setattr("hermes_cli.plugins._resolve_hook_callback_timeout", lambda: 0.05)
+    result = json.loads(_invoke(path, policy))
+    if mode in {"allow", "late_mutation"}:
+        assert result == {"ok": True}
+        assert json.loads(policy.EFFECT.read_text()) == {"target": "staging", "payload": {"approved": True}}
+    else:
+        assert "error" in result
+        assert "PRIVATE-ARGUMENT-CONTENT" not in json.dumps(result)
+        assert not policy.EFFECT.exists()
+    assert policy.SEEN
+    assert "PRIVATE-ARGUMENT-CONTENT" not in caplog.text
+    if mode in {"rewrite", "execution_rewrite"}:
+        assert policy.SEEN[-1]["target"] == "production"
+
+
+@pytest.mark.parametrize("path", ["direct", "agent", "connector", "connector_batch"])
+@pytest.mark.parametrize("stage", ["pre", "final"])
+def test_outer_hook_dispatch_error_blocks_then_recovers(policy, monkeypatch, path, stage):
+    from hermes_cli import plugins
+    attribute = "_dispatch_pre_tool_call_hooks" if stage == "pre" else "invoke_hook"
+    original = getattr(plugins, attribute)
+
+    def unavailable(*args, **kwargs):
+        if stage == "final" and args[0] != "authorize_tool_call":
+            return original(*args, **kwargs)
+        raise RuntimeError("PRIVATE-ARGUMENT-CONTENT")
+
+    monkeypatch.setattr(plugins, attribute, unavailable)
+    failed = json.loads(_invoke(path, policy))
+    assert "error" in failed and "not executed" in str(failed["error"])
+    assert "PRIVATE-ARGUMENT-CONTENT" not in json.dumps(failed)
+    assert not policy.EFFECT.exists()
+    monkeypatch.setattr(plugins, attribute, original)
+    assert json.loads(_invoke(path, policy)) == {"ok": True}
+    assert policy.EFFECT.exists()
